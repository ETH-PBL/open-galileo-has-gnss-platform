{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "jlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: Launch JLink GDB Server",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "device": "STM32H755ZI_M7",
            "jlinkDevice": "STM32H755ZI_M7",
            "interface": "swd",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${workspaceFolder}\\CM4\\build\\firmware_CM4.elf"
                },
                {
                    "imageFileName": "${workspaceFolder}\\CM7\\build\\firmware_CM7.elf"
                }
            ]
        }
    ]
}